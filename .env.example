# ---------------------------------------------------------------------------
# Kender — environment variables
# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
#
# Only VITE_* variables are exposed to the browser. They must be publishable
# values only — never put a secret key behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# --- Public (browser-exposed, publishable only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only: backend / database ---
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Server-only: AI providers ---
LOVABLE_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MODELSLAB_API_KEY=

# --- Server-only: web push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Server-only: payments ---
STRIPE_WEBHOOK_SECRET=
